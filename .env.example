# Copy this file to ".env" and fill in your key. Never commit the real .env file.

OPENAI_API_KEY=your_key_here

# Optional: point at a different OpenAI-compatible provider instead of
# OpenAI directly (e.g. Groq's free tier). Leave blank to use OpenAI.
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.1-8b-instant

# If using OpenAI directly, gpt-4o-mini is a good cheap default:
OPENAI_MODEL=gpt-4o-mini
